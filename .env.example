# Copy this file to .env and fill in your real keys locally.
# Never commit real API keys.

OPENAI_API_KEY=
AZURE_MAPS_KEY=
AZURE_MAPS_ADDRESS_URL=
AZURE_MAPS_POI_URL

# Optional: Azure Translator for non-Latin address/name translation in Stage 2A.
# Keep disabled unless you want the pipeline to make translation API calls.
ENABLE_TRANSLATION=false
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_REGION=

# Optional: Bing Web Search evidence for Stage 3 adjudication.
# Keep disabled unless you want the pipeline to make web search API calls.
ENABLE_WEB_SEARCH=false
BING_SEARCH_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
WEB_SEARCH_MAX_CALLS=0

# Optional: offline CSV/JSON evidence file with columns such as
# MDM_KEY, SOURCE_NAME, evidence_text, evidence_url, evidence_source.
WEB_EVIDENCE_FILE=
